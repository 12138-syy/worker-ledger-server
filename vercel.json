{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": [
        "app.js",
        "db.js",
        "package.json",
        "index.html",
        "public/index.html"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
